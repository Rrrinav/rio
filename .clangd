# .clangd
CompileFlags:
  Add:
    # 1. Force C++23 globally
    - -std=c++23
    - -stdlib=libc++
    - -Wall
    - -fprebuilt-module-path=./bin/pcms/
    - -fprebuilt-module-path=./bin/std/

  Compiler: clang++

# 4. Force .cppm files to be treated as Module Interfaces
# (Fixes "Unknown type name 'module'" errors)
---
If:
  PathMatch: .*\.cppm

CompileFlags:
  Add:
    - -x
    - c++-module
---
# bld.cpp is a host tool, not a project TU: the new b_ldr.hpp needs
# <generator>, which this box's libc++ does not ship. Parse it with the
# default stdlib (libstdc++), like the `clang++ ./bld.cpp -o bld` build.
If:
  PathMatch: bld\.cpp

CompileFlags:
  Remove:
    - -stdlib=libc++
---
# Files below the root (src/, examples/) fall back with their own directory
# as CWD, so root-relative module paths miss. Anchor them one level up.
# (src/*.cppm normally resolves via compile_commands.json; this is the net
# for examples/*.cpp and any file without a DB entry.)
If:
  PathMatch: (src|examples)/.*

CompileFlags:
  Add:
    - -fprebuilt-module-path=../bin/pcms/
    - -fprebuilt-module-path=../bin/std/
